
/* =========================================================
   GHARLIST â€” GLOBAL RESET
========================================================= */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  margin: 0;
  padding: 0;
  scroll-behavior: smooth;
}

body {
  margin: 0;
  padding: 0;
  min-width: 320px;
  background: #f7faf8;
  color: #123c2a;
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  max-width: 100%;
}


/* =========================================================
   HEADER
========================================================= */

.top-header {
  width: 100%;
  height: 76px;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1px solid #e2ebe6;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40px;
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(14px);
}

.brand-logo {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: #087f3f;
  font-size: 21px;
  font-weight: 850;
  letter-spacing: -0.5px;
  white-space: nowrap;
}

.brand-mark {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: #087f3f;
  color: white;
  font-size: 19px;
  font-weight: 900;
  box-shadow: 0 7px 18px rgba(8, 127, 63, 0.18);
}

.desktop-nav {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 5px;
  border: 1px solid #e1ebe5;
  background: #ffffff;
  border-radius: 18px;
  box-shadow: 0 10px 35px rgba(20, 55, 38, 0.08);
}

.desktop-nav a {
  color: #53645b;
  text-decoration: none;
  font-size: 15px;
  font-weight: 650;
  padding: 10px 13px;
  border-radius: 12px;
  transition:
    background 0.18s ease,
    color 0.18s ease,
    transform 0.18s ease;
}

.desktop-nav a:hover {
  color: #087f3f;
  background: #edf8f1;
}

.desktop-nav a.active {
  color: #087f3f;
  background: #e7f6ed;
}


/* =========================================================
   MOBILE NAV
========================================================= */

.mobile-nav {
  display: none;
}


/* =========================================================
   PAGE SYSTEM
========================================================= */

.page {
  width: 100%;
  min-height: calc(100vh - 76px);
  padding: 42px 32px 90px;
}

.page > * {
  max-width: 1240px;
  margin-left: auto;
  margin-right: auto;
}


/* =========================================================
   HOME
========================================================= */

.home-page {
  padding: 0;
  min-height: calc(100vh - 76px);
}

.home-page > .hero {
  max-width: none;
  width: 100%;
  min-height: calc(100vh - 76px);
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 78% 35%,
      rgba(75, 190, 124, 0.13),
      transparent 30%
    ),
    radial-gradient(
      circle at 20% 10%,
      rgba(29, 166, 91, 0.09),
      transparent 28%
    ),
    linear-gradient(
      135deg,
      #f4fbf7 0%,
      #ffffff 54%,
      #f1faf5 100%
    );
}

.hero::before {
  content: "";
  position: absolute;
  width: 520px;
  height: 520px;
  right: -150px;
  top: -170px;
  border-radius: 50%;
  background: rgba(14, 143, 72, 0.055);
  pointer-events: none;
}

.hero::after {
  content: "";
  position: absolute;
  width: 360px;
  height: 360px;
  left: -180px;
  bottom: -180px;
  border-radius: 50%;
  background: rgba(14, 143, 72, 0.05);
  pointer-events: none;
}

.hero > div {
  width: 100%;
  max-width: 1240px;
  margin: 0 auto;
  padding: 100px 32px;
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  min-height: 34px;
  padding: 7px 13px;
  border-radius: 999px;
  background: #e3f6eb;
  color: #08783c;
  font-size: 12px;
  line-height: 1;
  font-weight: 850;
  letter-spacing: 0.45px;
}

.hero h1 {
  margin: 22px 0 20px;
  max-width: 720px;
  color: #103d2b;
  font-size: clamp(48px, 6vw, 82px);
  line-height: 0.98;
  letter-spacing: -4px;
  font-weight: 850;
}

.hero h1 span {
  color: #087f3f;
}

.hero p {
  max-width: 660px;
  margin: 0 0 32px;
  color: #5d6f66;
  font-size: 18px;
  line-height: 1.7;
}


/* =========================================================
   BUTTONS
========================================================= */

.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 50px;
  padding: 13px 21px;
  border-radius: 15px;
  font-size: 15px;
  font-weight: 800;
  cursor: pointer;
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease;
}

.primary-button {
  border: 0;
  background: #07883f;
  color: #ffffff;
  box-shadow: 0 12px 25px rgba(8, 136, 63, 0.18);
}

.primary-button:hover {
  background: #067737;
  transform: translateY(-2px);
  box-shadow: 0 16px 30px rgba(8, 136, 63, 0.24);
}

.secondary-button {
  border: 1px solid #c9ded1;
  background: #ffffff;
  color: #08783c;
}

.secondary-button:hover {
  background: #eef9f2;
}

.primary-button.added {
  background: #126f42;
}


/* =========================================================
   PAGE HEADINGS
========================================================= */

.page-heading {
  margin-bottom: 24px;
}

.page-heading h1 {
  margin: 10px 0 5px;
  font-size: clamp(30px, 4vw, 48px);
  line-height: 1;
  letter-spacing: -1.5px;
  color: #123c2a;
}

.page-heading p {
  margin: 0;
  color: #718078;
}


/* =========================================================
   CATALOG TOOLBAR
========================================================= */

.catalog-toolbar {
  width: 100%;
  display: grid;
  grid-template-columns: minmax(260px, 1fr) 230px 230px;
  gap: 12px;
  align-items: center;
  margin: 24px auto;
}

.catalog-search {
  min-width: 0;
  height: 52px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 15px;
  background: #ffffff;
  border: 1px solid #dbe7e0;
  border-radius: 15px;
  color: #6d7c74;
  box-shadow: 0 5px 20px rgba(28, 64, 46, 0.04);
}

.catalog-search:focus-within {
  border-color: #79c89a;
  box-shadow: 0 0 0 4px rgba(8, 136, 63, 0.07);
}

.catalog-search input {
  flex: 1;
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: #183e2d;
}

.catalog-search input::placeholder {
  color: #9aa79f;
}

.catalog-toolbar select {
  width: 100%;
  height: 52px;
  padding: 0 13px;
  border: 1px solid #dbe7e0;
  border-radius: 15px;
  outline: 0;
  background: #ffffff;
  color: #42554b;
  cursor: pointer;
}

.icon-button {
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  flex: 0 0 auto;
  border: 0;
  border-radius: 50%;
  background: #edf5ef;
  color: #3e5d4c;
  cursor: pointer;
}


/* =========================================================
   PRODUCT GRID
========================================================= */

.product-grid {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
}

.product-card {
  min-width: 0;
  overflow: hidden;
  background: #ffffff;
  border: 1px solid #dfe9e3;
  border-radius: 22px;
  box-shadow: 0 8px 24px rgba(24, 63, 43, 0.045);
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    border-color 0.18s ease;
}

.product-card:hover {
  transform: translateY(-4px);
  border-color: #b9d8c5;
  box-shadow: 0 16px 34px rgba(24, 63, 43, 0.10);
}

.product-image-button {
  display: block;
  width: 100%;
  height: 235px;
  padding: 0;
  border: 0;
  background: #f2f8f4;
  cursor: pointer;
  overflow: hidden;
}

.product-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
  padding: 22px;
  transition: transform 0.25s ease;
}

.product-card:hover .product-image {
  transform: scale(1.035);
}

.product-image-fallback {
  width: 100%;
  height: 100%;
  min-height: 235px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef8f2;
  color: #087f3f;
}

.product-card-body {
  padding: 18px;
}

.product-brand {
  margin-bottom: 8px;
  color: #07883f;
  font-size: 12px;
  font-weight: 850;
  text-transform: uppercase;
  letter-spacing: 0.45px;
}

.product-name {
  width: 100%;
  min-height: 48px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #102f23;
  text-align: left;
  font-size: 16px;
  line-height: 1.35;
  font-weight: 750;
  cursor: pointer;
}

.product-quantity {
  margin-top: 11px;
  color: #738078;
  font-size: 13px;
}

.product-card-footer {
  margin-top: 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.product-card-footer strong {
  color: #103d2b;
  font-size: 19px;
}

.add-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-width: 68px;
  min-height: 40px;
  padding: 8px 14px;
  border: 0;
  border-radius: 12px;
  background: #07883f;
  color: #ffffff;
  font-size: 14px;
  font-weight: 800;
  cursor: pointer;
}

.add-button:hover {
  background: #067737;
}

.add-button.added {
  background: #126f42;
}


/* =========================================================
   FILTER CHIPS
========================================================= */

.active-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 20px;
}

.active-filters button {
  border: 1px solid #b9dfc8;
  background: #edf9f1;
  color: #087c3b;
  padding: 8px 12px;
  border-radius: 999px;
  cursor: pointer;
}


/* =========================================================
   LOAD MORE
========================================================= */

.load-more-wrap {
  display: flex;
  justify-content: center;
  padding: 36px 0 18px;
}

.load-more-button {
  border: 0;
  border-radius: 14px;
  background: #07883f;
  color: white;
  padding: 14px 24px;
  font-weight: 800;
  cursor: pointer;
  display: inline-flex;
  gap: 12px;
  align-items: center;
  box-shadow: 0 10px 24px rgba(8, 136, 63, 0.16);
}

.load-more-button:hover {
  background: #067737;
}

.load-more-button span {
  opacity: .78;
  font-weight: 600;
}

.catalog-end {
  text-align: center;
  color: #718078;
  padding: 24px;
}


/* =========================================================
   PRODUCT DETAIL
========================================================= */

.product-detail-page {
  max-width: none !important;
}

.back-button {
  max-width: 1240px;
  margin: 0 auto 24px;
  padding: 0;
  border: 0;
  background: transparent;
  display: flex;
  gap: 8px;
  align-items: center;
  color: #087c3b;
  font-weight: 750;
  cursor: pointer;
}

.product-detail {
  width: 100%;
  max-width: 1240px;
  display: grid;
  grid-template-columns: minmax(320px, 1fr) minmax(320px, 1fr);
  gap: 55px;
  margin: 0 auto;
  padding: 34px;
  background: #ffffff;
  border: 1px solid #dfe9e3;
  border-radius: 28px;
  box-shadow: 0 12px 35px rgba(20, 55, 38, 0.06);
}

.detail-image {
  min-height: 480px;
  border-radius: 22px;
  overflow: hidden;
  background: #f2f8f4;
}

.detail-product-image {
  width: 100%;
  height: 480px;
  object-fit: contain;
  padding: 30px;
}

.detail-info {
  padding: 22px 0;
}

.detail-info h1 {
  margin: 10px 0 18px;
  color: #103d2b;
  font-size: clamp(28px, 4vw, 46px);
  line-height: 1.08;
  letter-spacing: -1.5px;
}

.detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.detail-meta span {
  padding: 8px 12px;
  border-radius: 999px;
  background: #edf7f0;
  color: #496056;
  font-size: 13px;
}

.detail-price {
  margin: 28px 0 18px;
  color: #075f30;
  font-size: 34px;
  font-weight: 850;
}

.detail-description {
  color: #617168;
  line-height: 1.7;
}

.detail-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 30px;
}

.product-reference {
  margin-top: 30px;
  padding-top: 20px;
  border-top: 1px solid #e5ebe7;
  color: #7a887f;
  font-size: 13px;
  line-height: 1.9;
}


/* =========================================================
   EMPTY / LOADING
========================================================= */

.loading-state {
  min-height: 50vh;
  display: grid;
  place-items: center;
  color: #087c3b;
  font-weight: 750;
}

.empty-state {
  width: 100%;
  max-width: 700px !important;
  margin: 50px auto !important;
  padding: 55px 30px;
  text-align: center;
  border: 1px dashed #cbdcd1;
  border-radius: 24px;
  background: #ffffff;
}

.empty-state h1,
.empty-state h2 {
  margin: 0 0 10px;
  color: #143d2c;
}

.empty-state p {
  margin: 0 0 22px;
  color: #738078;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1050px) {

  .top-header {
    padding: 0 24px;
  }

  .desktop-nav a {
    padding: 9px 10px;
  }

  .product-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .catalog-toolbar {
    grid-template-columns: 1fr 1fr;
  }

  .catalog-search {
    grid-column: 1 / -1;
  }

  .product-detail {
    gap: 30px;
  }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 760px) {

  .top-header {
    height: 64px;
    padding: 0 16px;
  }

  .brand-logo {
    font-size: 18px;
  }

  .brand-mark {
    width: 34px;
    height: 34px;
    border-radius: 10px;
  }

  .desktop-nav {
    display: none;
  }

  .mobile-nav {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 200;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    padding: 7px;
    border: 1px solid #dbe8e0;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 15px 40px rgba(20, 55, 38, 0.14);
    backdrop-filter: blur(16px);
  }

  .mobile-nav a {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    padding: 8px 4px;
    border-radius: 13px;
    color: #718078;
    font-size: 10px;
    font-weight: 750;
  }

  .mobile-nav a.active {
    background: #07883f;
    color: #ffffff;
  }

  .page {
    min-height: calc(100vh - 64px);
    padding: 28px 16px 100px;
  }

  .home-page {
    padding: 0;
  }

  .home-page > .hero {
    min-height: calc(100vh - 64px);
  }

  .hero > div {
    padding: 65px 20px 100px;
  }

  .hero h1 {
    font-size: clamp(42px, 13vw, 62px);
    letter-spacing: -2.8px;
  }

  .hero p {
    font-size: 16px;
  }

  .catalog-toolbar {
    display: grid;
    grid-template-columns: 1fr;
  }

  .catalog-search {
    grid-column: auto;
  }

  .catalog-toolbar select {
    width: 100%;
  }

  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .product-image-button {
    height: 170px;
  }

  .product-image {
    padding: 15px;
  }

  .product-card-body {
    padding: 13px;
  }

  .product-name {
    min-height: 44px;
    font-size: 14px;
  }

  .product-card-footer {
    align-items: flex-end;
  }

  .product-card-footer strong {
    font-size: 16px;
  }

  .add-button {
    min-width: 58px;
    min-height: 36px;
    padding: 7px 10px;
    font-size: 12px;
  }

  .product-detail {
    grid-template-columns: 1fr;
    gap: 20px;
    padding: 16px;
    border-radius: 20px;
  }

  .detail-image {
    min-height: 320px;
  }

  .detail-product-image {
    height: 320px;
  }

  .detail-info {
    padding: 8px 4px 20px;
  }
}


/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 430px) {

  .product-grid {
    grid-template-columns: 1fr;
  }

  .product-image-button {
    height: 230px;
  }

  .hero h1 {
    font-size: 43px;
  }

  .hero > div {
    padding-left: 16px;
    padding-right: 16px;
  }
}
/* =========================================================
   GHARLIST â€” FINAL CATALOG DESKTOP SPACING
   ========================================================= */

.page-shell {
  width: min(1640px, calc(100% - 88px));
  margin-left: auto;
  margin-right: auto;
  padding: 42px 0 100px;
  box-sizing: border-box;
}

.products-page {
  width: min(1640px, calc(100% - 88px));
  margin-left: auto;
  margin-right: auto;
}

.products-heading {
  margin-bottom: 28px;
}

.products-heading h1 {
  margin: 8px 0 8px;
}

.products-heading .muted {
  margin: 0;
}

.catalog-toolbar {
  margin-bottom: 28px;
}

.product-grid {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 22px;
}

.product-card {
  min-width: 0;
}

.product-card .product-image,
.product-card img {
  max-height: 230px;
  object-fit: contain;
}

.product-image-fallback {
  min-height: 230px;
}

/* Tablet */
@media (max-width: 1200px) {
  .page-shell,
  .products-page {
    width: min(100% - 48px, 1100px);
  }

  .product-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

/* Mobile */
@media (max-width: 760px) {
  .page-shell,
  .products-page {
    width: calc(100% - 28px);
    padding-top: 24px;
  }

  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .product-card .product-image,
  .product-card img,
  .product-image-fallback {
    max-height: 170px;
    min-height: 170px;
  }
}

@media (max-width: 480px) {
  .page-shell,
  .products-page {
    width: calc(100% - 20px);
  }

  .product-grid {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   GHARLIST â€” VOICE ASSISTANT
   ========================================================= */

.voice-page {
  padding-top: 42px;
}

.voice-hero {
  display: grid;
  grid-template-columns: 1.35fr .65fr;
  gap: 32px;
  align-items: stretch;
  margin-bottom: 28px;
}

.voice-hero-copy {
  padding: 42px;
  border-radius: 28px;
  background: linear-gradient(135deg, #e8f8ef, #f7fbf8);
  border: 1px solid #d8e9df;
}

.voice-hero-copy h1 {
  max-width: 700px;
  margin: 12px 0;
  font-size: clamp(2.4rem, 5vw, 4.8rem);
  line-height: .98;
  letter-spacing: -2px;
  color: #063f2b;
}

.voice-hero-copy p:not(.eyebrow) {
  max-width: 680px;
  margin: 0;
  color: #607168;
  font-size: 1.08rem;
  line-height: 1.7;
}

.voice-mic-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 28px;
  border: 1px solid #dbe8e0;
  border-radius: 28px;
  background: #fff;
  box-shadow: 0 16px 45px rgba(0,0,0,.06);
}

.voice-language-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  margin-bottom: 10px;
}

.voice-language {
  border: 1px solid #d9e6df;
  background: #f7faf8;
  border-radius: 999px;
  padding: 9px 13px;
  cursor: pointer;
  font-weight: 700;
  color: #52645b;
}

.voice-language.active {
  background: #e0f5e9;
  border-color: #0a8a4b;
  color: #087a42;
}

.voice-mic {
  width: 116px;
  height: 116px;
  border: 0;
  border-radius: 50%;
  background: #07883f;
  color: white;
  display: grid;
  place-items: center;
  cursor: pointer;
  box-shadow: 0 14px 35px rgba(7,136,63,.25);
  transition: transform .2s ease;
}

.voice-mic:hover {
  transform: scale(1.04);
}

.voice-mic.listening {
  background: #d94b3d;
  animation: voicePulse 1.4s infinite;
}

@keyframes voicePulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(217,75,61,.28);
  }
  50% {
    box-shadow: 0 0 0 22px rgba(217,75,61,0);
  }
}

.voice-mic-panel strong {
  color: #123d2d;
  font-size: 1.05rem;
}

.voice-hint {
  color: #89968f;
  font-size: .82rem;
}

.voice-command-card {
  display: flex;
  align-items: center;
  gap: 16px;
  min-height: 86px;
  padding: 18px 22px;
  margin-bottom: 38px;
  border: 1px solid #dbe8e0;
  border-radius: 18px;
  background: white;
}

.voice-command-icon {
  width: 48px;
  height: 48px;
  flex: 0 0 48px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: #e7f6ed;
  color: #07883f;
}

.voice-command-card > div:nth-child(2) {
  flex: 1;
}

.voice-command-label {
  font-size: .72rem;
  font-weight: 800;
  letter-spacing: .08em;
  color: #0b8746;
}

.voice-command-card p {
  margin: 5px 0 0;
  color: #24372e;
  font-size: 1.02rem;
}

.voice-results-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 20px;
}

.voice-results-header h2 {
  margin: 6px 0 0;
  color: #073e2c;
}

.add-all-button {
  white-space: nowrap;
}

.voice-product-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
}

.voice-product-card {
  overflow: hidden;
  border: 1px solid #dbe8e0;
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 8px 28px rgba(0,0,0,.04);
}

.voice-product-image {
  height: 220px;
  padding: 18px;
  background: #f1f7f3;
}

.voice-product-image img,
.voice-product-image > div {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.voice-product-info {
  padding: 18px;
}

.voice-product-info h3 {
  min-height: 46px;
  margin: 7px 0;
  font-size: 1rem;
  line-height: 1.35;
}

.voice-product-info .product-brand {
  color: #07883f;
  font-weight: 800;
  font-size: .75rem;
  text-transform: uppercase;
}

.product-quantity {
  display: block;
  color: #7c8982;
  font-size: .82rem;
  margin-bottom: 9px;
}

.product-price {
  display: block;
  margin-bottom: 15px;
  font-size: 1.12rem;
  color: #123d2d;
}

.added-button {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 7px;
  border: 1px solid #b9dfc8;
  background: #e7f7ed;
  color: #087b42;
  cursor: pointer;
}

.voice-product-info .button {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 7px;
}

.voice-empty {
  padding: 70px 20px;
  text-align: center;
  border: 1px dashed #cbded3;
  border-radius: 24px;
  background: #fbfdfc;
}

.voice-empty-icon {
  width: 72px;
  height: 72px;
  margin: 0 auto 18px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #e4f6eb;
  color: #07883f;
}

.voice-empty h3 {
  margin: 0 0 8px;
  color: #123d2d;
}

.voice-empty p {
  margin: 0 auto 20px;
  max-width: 550px;
  color: #7a8981;
}

.voice-examples {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 9px;
}

.voice-examples span {
  padding: 9px 13px;
  border-radius: 999px;
  background: #eef6f1;
  color: #47705b;
  font-size: .84rem;
  font-weight: 700;
}

.voice-bottom-action {
  display: flex;
  justify-content: center;
  margin-top: 30px;
}

.button.large {
  padding: 14px 24px;
  display: inline-flex;
  align-items: center;
  gap: 9px;
}

@media (max-width: 1100px) {
  .voice-hero {
    grid-template-columns: 1fr;
  }

  .voice-product-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .voice-hero-copy {
    padding: 28px;
  }

  .voice-hero-copy h1 {
    font-size: 2.7rem;
  }

  .voice-product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .voice-product-image {
    height: 175px;
    padding: 12px;
  }

  .voice-command-card {
    align-items: flex-start;
  }

  .voice-results-header {
    align-items: flex-start;
  }
}

@media (max-width: 480px) {
  .voice-product-grid {
    grid-template-columns: 1fr;
  }

  .voice-command-card {
    flex-wrap: wrap;
  }

  .voice-command-card .button {
    width: 100%;
  }
}

/* ============================================================
   GHARLIST â€” COMPLETE SHOPPING FLOW
   ============================================================ */

.primary-button,
.secondary-button,
.back-button {
  text-decoration: none;
  border: 0;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-weight: 800;
  border-radius: 12px;
  transition: .18s ease;
}

.primary-button {
  padding: 12px 18px;
  background: #07883f;
  color: #fff;
}

.primary-button:hover {
  background: #056d32;
  transform: translateY(-1px);
}

.secondary-button {
  padding: 12px 18px;
  background: #eef7f1;
  color: #087a42;
  border: 1px solid #d5e8dc;
}

.secondary-button:hover {
  background: #e1f2e7;
}

.secondary-button.full,
.primary-button.full {
  width: 100%;
  box-sizing: border-box;
}

.danger {
  color: #c43f34 !important;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 25px;
}

.home-flow {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  margin-top: 28px;
}

.flow-card {
  padding: 25px;
  border: 1px solid #dceae2;
  border-radius: 20px;
  background: #fff;
}

.flow-card span {
  color: #07883f;
  font-weight: 900;
}

.flow-card strong {
  display: block;
  margin-top: 8px;
  font-size: 1.1rem;
}

.flow-card p {
  color: #75847b;
  margin-bottom: 0;
}

.voice-main {
  display: grid;
  grid-template-columns: 1.3fr .7fr;
  gap: 28px;
  align-items: stretch;
  margin-bottom: 25px;
}

.voice-main-copy {
  padding: 45px;
  border-radius: 28px;
  background: linear-gradient(135deg,#e8f8ef,#f8fcf9);
  border: 1px solid #d8e9df;
}

.voice-main-copy h1 {
  margin: 12px 0;
  color: #063f2b;
  font-size: clamp(2.6rem,5vw,4.6rem);
  line-height: 1;
}

.voice-main-copy p {
  max-width: 650px;
  color: #68776f;
  line-height: 1.7;
}

.voice-control {
  padding: 28px;
  border-radius: 28px;
  background: #fff;
  border: 1px solid #dbe8e0;
  box-shadow: 0 15px 40px rgba(0,0,0,.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
}

.language-tabs {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 7px;
}

.language-tab {
  border: 1px solid #d8e7de;
  border-radius: 999px;
  padding: 8px 12px;
  background: #f7faf8;
  color: #53645b;
  font-weight: 700;
  cursor: pointer;
}

.language-tab.active {
  background: #e0f5e9;
  color: #087a42;
  border-color: #0a8a4b;
}

.big-mic {
  width: 118px;
  height: 118px;
  border: 0;
  border-radius: 50%;
  background: #07883f;
  color: #fff;
  display: grid;
  place-items: center;
  cursor: pointer;
  box-shadow: 0 14px 35px rgba(7,136,63,.25);
}

.big-mic.listening {
  background: #d94b3d;
  animation: ghVoicePulse 1.3s infinite;
}

@keyframes ghVoicePulse {
  50% {
    box-shadow: 0 0 0 22px rgba(217,75,61,0);
  }
}

.voice-transcript {
  padding: 18px 22px;
  border: 1px solid #dce9e1;
  border-radius: 17px;
  background: #fff;
  margin-bottom: 35px;
}

.voice-transcript span {
  color: #07883f;
  font-size: .72rem;
  font-weight: 900;
  letter-spacing: .08em;
}

.voice-transcript p {
  margin: 6px 0 0;
  color: #263a30;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 20px;
}

.section-heading h2 {
  margin: 5px 0 0;
  color: #073e2c;
}

.voice-results-grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 18px;
}

.voice-result-card {
  overflow: hidden;
  border: 1px solid #dce9e1;
  border-radius: 20px;
  background: #fff;
}

.voice-result-image {
  height: 210px;
  padding: 15px;
  background: #f2f7f4;
}

.voice-result-image img,
.voice-result-image > div {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.voice-result-body {
  padding: 17px;
}

.voice-result-body h3 {
  min-height: 46px;
  font-size: .98rem;
  line-height: 1.35;
  margin: 6px 0;
}

.voice-result-body small {
  display: block;
  color: #87928c;
  margin-bottom: 8px;
}

.voice-result-body > strong {
  display: block;
  color: #123d2d;
  margin-bottom: 13px;
}

.added-button {
  width: 100%;
  padding: 11px;
  border: 1px solid #b9dfc8;
  border-radius: 11px;
  background: #e7f7ed;
  color: #087b42;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  font-weight: 800;
  cursor: pointer;
}

.voice-empty,
.list-empty {
  padding: 75px 25px;
  text-align: center;
  border: 1px dashed #cbded3;
  border-radius: 24px;
  background: #fbfdfc;
}

.voice-empty svg,
.list-empty > svg {
  color: #07883f;
}

.voice-empty h3,
.list-empty h1 {
  color: #123d2d;
}

.voice-empty p,
.list-empty p {
  color: #7b8982;
}

.center-action {
  display: flex;
  justify-content: center;
  margin-top: 28px;
}

.list-header,
.history-header,
.report-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.list-header h1,
.history-header h1,
.report-header h1,
.share-header h1 {
  margin: 7px 0;
  color: #073e2c;
}

.list-header p,
.history-header p,
.report-header p,
.share-header p {
  margin: 0;
  color: #7b8982;
}

.list-layout {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: 25px;
  align-items: start;
}

.shopping-items {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.shopping-item {
  display: grid;
  grid-template-columns: 86px 1fr auto auto auto;
  align-items: center;
  gap: 16px;
  padding: 14px;
  background: #fff;
  border: 1px solid #dce9e1;
  border-radius: 17px;
}

.shopping-item-image {
  width: 86px;
  height: 86px;
  padding: 5px;
  border-radius: 12px;
  background: #f2f7f4;
}

.shopping-item-image img,
.shopping-item-image > div {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.shopping-item-info h3 {
  margin: 4px 0;
  font-size: .98rem;
}

.shopping-item-info small {
  display: block;
  color: #7e8b84;
}

.shopping-item-info strong {
  display: block;
  margin-top: 7px;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 10px;
  border: 1px solid #d6e5dc;
  border-radius: 10px;
  padding: 4px;
}

.quantity-control button {
  width: 30px;
  height: 30px;
  border: 0;
  border-radius: 7px;
  background: #eef7f1;
  color: #087a42;
  display: grid;
  place-items: center;
  cursor: pointer;
}

.quantity-control span {
  min-width: 20px;
  text-align: center;
  font-weight: 800;
}

.line-total {
  min-width: 95px;
  text-align: right;
}

.remove-button,
.icon-button {
  border: 0;
  background: transparent;
  color: #9a6d68;
  cursor: pointer;
}

.list-summary {
  position: sticky;
  top: 20px;
  padding: 25px;
  border-radius: 20px;
  background: #fff;
  border: 1px solid #dce9e1;
  box-shadow: 0 12px 35px rgba(0,0,0,.05);
}

.list-summary h2 {
  color: #073e2c;
  margin: 7px 0 25px;
}

.summary-row,
.summary-total {
  display: flex;
  justify-content: space-between;
  padding: 12px 0;
  border-bottom: 1px solid #edf2ef;
}

.summary-row span {
  color: #75837b;
}

.summary-total {
  margin: 7px 0 20px;
  border: 0;
  font-size: 1.2rem;
}

.summary-total strong {
  color: #07883f;
}

.back-button {
  width: 100%;
  padding: 12px;
  margin-top: 10px;
  background: transparent;
  color: #4d6257;
}

.report-summary {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 15px;
  margin-bottom: 25px;
}

.report-summary > div {
  padding: 23px;
  border: 1px solid #dce9e1;
  border-radius: 17px;
  background: #fff;
}

.report-summary span {
  display: block;
  color: #7a8981;
}

.report-summary strong {
  display: block;
  margin-top: 7px;
  font-size: 1.5rem;
  color: #087a42;
}

.report-table {
  overflow: hidden;
  border: 1px solid #dce9e1;
  border-radius: 18px;
  background: #fff;
}

.report-table-head,
.report-row {
  display: grid;
  grid-template-columns: 1fr 80px 130px 140px;
  gap: 15px;
  align-items: center;
  padding: 16px 20px;
}

.report-table-head {
  background: #eef7f1;
  color: #416154;
  font-weight: 800;
}

.report-row {
  border-top: 1px solid #edf2ef;
}

.report-product strong,
.report-product small {
  display: block;
}

.report-product small {
  margin-top: 4px;
  color: #89958f;
}

.report-bottom {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 25px;
}

.share-header {
  margin-bottom: 30px;
}

.share-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 16px;
}

.share-card {
  padding: 28px;
  text-align: left;
  border: 1px solid #dce9e1;
  border-radius: 20px;
  background: #fff;
  cursor: pointer;
  transition: .18s ease;
}

.share-card:hover {
  transform: translateY(-2px);
  border-color: #a9cfb8;
}

.share-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: #e5f6eb;
  color: #07883f;
  margin-bottom: 15px;
}

.share-card strong,
.share-card small {
  display: block;
}

.share-card strong {
  color: #173e2e;
  font-size: 1rem;
}

.share-card small {
  margin-top: 5px;
  color: #849189;
}

.share-preview {
  margin-top: 22px;
  padding: 17px;
  border: 1px solid #dce9e1;
  border-radius: 15px;
  background: #fff;
}

.share-preview pre {
  white-space: pre-wrap;
  line-height: 1.6;
  color: #52635a;
}

.history-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 18px;
}

.history-card {
  padding: 20px;
  border: 1px solid #dce9e1;
  border-radius: 19px;
  background: #fff;
}

.history-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.history-date {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #65756c;
  font-size: .8rem;
}

.history-stats {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 8px;
  margin: 20px 0;
}

.history-stats div {
  padding: 10px;
  border-radius: 10px;
  background: #f2f7f4;
}

.history-stats small,
.history-stats strong {
  display: block;
}

.history-stats small {
  color: #829087;
}

.history-stats strong {
  margin-top: 4px;
  color: #173e2e;
}

.history-preview {
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-height: 80px;
  margin-bottom: 15px;
}

.history-preview span {
  font-size: .83rem;
  color: #65756c;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.empty-icon {
  width: 75px;
  height: 75px;
  margin: 0 auto 18px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #e5f6eb;
  color: #07883f;
}

.empty-icon.success {
  background: #dff5e7;
}

.empty-actions {
  display: flex;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
}

@media (max-width: 1100px) {

  .voice-main {
    grid-template-columns: 1fr;
  }

  .voice-results-grid {
    grid-template-columns: repeat(3,1fr);
  }

  .list-layout {
    grid-template-columns: 1fr;
  }

  .list-summary {
    position: static;
  }

  .history-grid {
    grid-template-columns: repeat(2,1fr);
  }

}

@media (max-width: 760px) {

  .home-flow {
    grid-template-columns: 1fr;
  }

  .voice-main-copy {
    padding: 28px;
  }

  .voice-results-grid {
    grid-template-columns: repeat(2,1fr);
  }

  .shopping-item {
    grid-template-columns: 70px 1fr auto;
  }

  .shopping-item-image {
    width: 70px;
    height: 70px;
  }

  .shopping-item .line-total {
    display: none;
  }

  .shopping-item .remove-button {
    grid-column: 3;
  }

  .report-summary {
    grid-template-columns: 1fr;
  }

  .report-table-head {
    display: none;
  }

  .report-row {
    grid-template-columns: 1fr auto;
  }

  .report-row > span:nth-child(2),
  .report-row > span:nth-child(3) {
    display: none;
  }

  .report-row > strong {
    text-align: right;
  }

  .share-grid,
  .history-grid {
    grid-template-columns: 1fr;
  }

  .list-header,
  .history-header,
  .report-header {
    flex-direction: column;
  }

}

@media (max-width: 480px) {

  .voice-results-grid {
    grid-template-columns: 1fr;
  }

  .shopping-item {
    grid-template-columns: 62px 1fr;
  }

  .quantity-control {
    grid-column: 2;
    justify-self: start;
  }

  .shopping-item .remove-button {
    position: absolute;
    margin-left: 240px;
  }

  .report-bottom {
    flex-direction: column;
  }

  .report-bottom > * {
    width: 100%;
  }

}

/* =========================================================
   GHARLIST FINAL REPORT + SHARE
   ========================================================= */

.report-page,
.share-page {
  width: min(1180px, calc(100% - 32px));
  margin: 0 auto;
  padding: 42px 0 90px;
}

.report-header,
.share-header {
  margin-bottom: 28px;
}

.report-header h1,
.share-header h1 {
  margin: 8px 0 10px;
  font-size: clamp(32px, 5vw, 52px);
  line-height: 1.05;
}

.report-header p,
.share-header p {
  color: #64756b;
  font-size: 16px;
  margin: 0;
}

.report-total-grid,
.share-total-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin: 24px 0 30px;
}

.report-total-grid > div,
.share-total-card > div {
  padding: 24px;
  border-radius: 22px;
  background: #eaf9ed;
  border: 1px solid #d5ebda;
}

.report-total-grid span,
.share-total-card span {
  display: block;
  color: #64756b;
  font-size: 14px;
  margin-bottom: 8px;
}

.report-total-grid strong,
.share-total-card strong {
  color: #075f38;
  font-size: 30px;
}

.report-items {
  display: grid;
  gap: 16px;
}

.report-item {
  display: grid;
  grid-template-columns: 190px 1fr 170px;
  gap: 24px;
  align-items: center;
  padding: 20px;
  border-radius: 24px;
  border: 1px solid #dcebe2;
  background: #fff;
  box-shadow: 0 8px 28px rgba(17, 75, 45, .06);
}

.report-item-image {
  width: 190px;
  height: 170px;
  border-radius: 18px;
  background: #f2f8f4;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.report-item-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.report-item-image span {
  color: #718477;
  font-size: 13px;
  text-align: center;
  padding: 12px;
}

.report-index {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: #eaf9ed;
  color: #075f38;
  font-weight: 700;
  margin-bottom: 8px;
}

.report-item-info h2 {
  margin: 0 0 10px;
  color: #075f38;
  font-size: 24px;
}

.report-item-info p {
  margin: 5px 0;
  color: #64756b;
}

.report-item-price {
  display: flex;
  flex-direction: column;
  gap: 14px;
  align-items: flex-end;
}

.report-item-price span {
  color: #64756b;
}

.report-item-price strong {
  color: #075f38;
  font-size: 27px;
}

.report-grand-total {
  margin-top: 22px;
  padding: 28px 32px;
  border-radius: 24px;
  background: linear-gradient(
    135deg,
    #eaf9ed,
    #dff5e6
  );
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.report-grand-total span {
  font-size: 20px;
  font-weight: 700;
}

.report-grand-total strong {
  color: #075f38;
  font-size: 36px;
}

.report-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}

.share-topbar {
  margin-bottom: 20px;
}

.back-button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #075f38;
  text-decoration: none;
  font-weight: 700;
}

.share-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin: 28px 0;
}

.share-action {
  border: 1px solid #dcebe2;
  border-radius: 22px;
  background: #fff;
  min-height: 150px;
  padding: 24px;
  cursor: pointer;
  text-align: left;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8px;
  transition:
    transform .18s ease,
    box-shadow .18s ease,
    border-color .18s ease;
}

.share-action:hover {
  transform: translateY(-2px);
  box-shadow:
    0 12px 30px rgba(17, 75, 45, .09);
  border-color: #9bd1ae;
}

.share-action svg {
  color: #075f38;
}

.share-action span {
  font-size: 19px;
  font-weight: 800;
  color: #173e2e;
}

.share-action small {
  color: #718477;
}

.share-action.whatsapp {
  background: #effaf2;
}

.share-action.email {
  background: #f5f8ff;
}

.share-status {
  padding: 14px 18px;
  border-radius: 14px;
  background: #eaf9ed;
  color: #075f38;
  font-weight: 700;
  margin-bottom: 20px;
}

.share-preview {
  background: #fff;
  border: 1px solid #dcebe2;
  border-radius: 26px;
  padding: 24px;
  box-shadow: 0 10px 32px rgba(17, 75, 45, .06);
}

.share-preview-header {
  display: flex;
  justify-content: space-between;
  padding-bottom: 16px;
  margin-bottom: 10px;
  border-bottom: 1px solid #e4eee7;
  font-weight: 800;
  color: #075f38;
}

.share-preview-item {
  display: grid;
  grid-template-columns: 100px 1fr auto;
  gap: 16px;
  align-items: center;
  padding: 16px 0;
  border-bottom: 1px solid #edf3ef;
}

.share-preview-image {
  width: 100px;
  height: 90px;
  border-radius: 14px;
  background: #f2f8f4;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.share-preview-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.share-preview-image span {
  font-size: 10px;
  text-align: center;
  color: #718477;
}

.share-preview-item strong {
  color: #075f38;
}

.share-preview-item p {
  margin: 3px 0;
  color: #718477;
  font-size: 13px;
}

.share-preview-total {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 12px 24px;
  margin-top: 18px;
  padding: 22px;
  border-radius: 18px;
  background: #eaf9ed;
}

.share-preview-total strong {
  color: #075f38;
}

.share-preview-footer {
  padding-top: 20px;
  text-align: center;
  color: #718477;
  font-weight: 700;
}

.share-note {
  margin-top: 22px;
  padding: 20px;
  border-radius: 18px;
  background: #f5f9f6;
  color: #64756b;
}

.share-note strong {
  color: #075f38;
}

.share-note p {
  margin: 8px 0 0;
  line-height: 1.55;
}

@media (max-width: 850px) {
  .report-item {
    grid-template-columns: 140px 1fr;
  }

  .report-item-image {
    width: 140px;
    height: 135px;
  }

  .report-item-price {
    grid-column: 2;
    align-items: flex-start;
    flex-direction: row;
    justify-content: space-between;
  }

  .share-actions {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 620px) {
  .report-page,
  .share-page {
    width: min(
      100% - 20px,
      1180px
    );
    padding-top: 25px;
  }

  .report-total-grid,
  .share-total-card {
    grid-template-columns: 1fr;
  }

  .report-total-grid > div,
  .share-total-card > div {
    padding: 18px;
  }

  .report-item {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .report-item-image {
    width: 100%;
    height: 190px;
  }

  .report-item-price {
    grid-column: auto;
  }

  .report-grand-total {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .share-actions {
    grid-template-columns: 1fr;
  }

  .share-preview-item {
    grid-template-columns: 80px 1fr;
  }

  .share-preview-item > strong {
    grid-column: 2;
  }

  .share-preview-image {
    width: 80px;
    height: 80px;
  }
}
 
/* GHARLIST MY LIST FINAL UI FIX */

.shopping-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin: 18px 0;
}

.shopping-list-item {
  width: 100%;
  min-height: 150px;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 140px minmax(0, 1fr) auto;
  align-items: center;
  gap: 20px;
  padding: 16px;
  background: #ffffff;
  border: 1px solid #dfe9e3;
  border-radius: 18px;
  box-shadow: 0 3px 14px rgba(0,0,0,.05);
  overflow: hidden;
}

.shopping-list-image {
  width: 140px;
  height: 120px;
  min-width: 140px;
  max-width: 140px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 14px;
  background: #f7faf8;
  box-sizing: border-box;
}

.shopping-list-image img,
.shopping-list-image picture,
.shopping-list-image > div,
.shopping-list-image > span {
  width: 100%;
  height: 100%;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.shopping-list-image img {
  display: block;
  object-fit: contain;
}

.shopping-list-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6px;
}

.shopping-list-info .product-brand {
  margin: 0;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .04em;
  text-transform: uppercase;
}

.shopping-list-info h3 {
  margin: 0;
  font-size: 18px;
  line-height: 1.3;
  font-weight: 750;
  color: #123d2b;
  overflow-wrap: anywhere;
}

.shopping-list-info .product-unit {
  margin: 0;
  font-size: 14px;
  color: #64746c;
}

.shopping-list-info .product-price {
  margin: 2px 0 0;
  font-size: 17px;
  color: #123d2b;
}

.shopping-list-actions {
  min-width: 150px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: 10px;
}

.quantity-control {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 4px;
  background: #f5faf7;
  border: 1px solid #d6e7dd;
  border-radius: 12px;
}

.quantity-control button {
  width: 34px;
  height: 34px;
  min-width: 34px;
  padding: 0;
  border: 0;
  border-radius: 9px;
  background: #ffffff;
  color: #07883f;
  font-size: 21px;
  font-weight: 700;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.quantity-control button:hover {
  background: #e9f7ef;
}

.quantity-control span {
  min-width: 34px;
  padding: 0 5px;
  text-align: center;
  font-size: 16px;
  font-weight: 800;
  color: #173c2b;
}

.line-total {
  min-width: 100px;
  text-align: right;
  font-size: 18px;
  color: #0b7f3d;
  white-space: nowrap;
}

.remove-button {
  border: 0;
  background: transparent;
  color: #9b5c5c;
  cursor: pointer;
  font-size: 13px;
  padding: 4px 0;
}

.remove-button:hover {
  color: #c0392b;
}

.list-summary {
  width: 100%;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 14px;
  margin-top: 8px;
}

.list-footer-actions {
  width: 100%;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12px;
  margin-top: 8px;
  padding-bottom: 30px;
}

.shopping-list-image * {
  box-sizing: border-box;
}

@media (max-width: 900px) {
  .shopping-list-item {
    grid-template-columns: 110px minmax(0,1fr);
    gap: 14px;
    padding: 12px;
  }

  .shopping-list-image {
    width: 110px;
    height: 100px;
    min-width: 110px;
    max-width: 110px;
  }

  .shopping-list-actions {
    grid-column: 2;
    min-width: 0;
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .line-total {
    text-align: left;
  }
}

@media (max-width: 620px) {
  .shopping-list-item {
    grid-template-columns: 82px minmax(0,1fr);
    gap: 12px;
    padding: 10px;
  }

  .shopping-list-image {
    width: 82px;
    height: 82px;
    min-width: 82px;
    max-width: 82px;
  }

  .shopping-list-info h3 {
    font-size: 15px;
  }

  .shopping-list-info .product-unit {
    font-size: 12px;
  }

  .shopping-list-actions {
    grid-column: 1 / -1;
    flex-wrap: wrap;
    gap: 8px;
  }

  .list-summary {
    grid-template-columns: 1fr;
  }

  .list-footer-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .list-footer-actions button,
  .list-footer-actions a {
    width: 100%;
  }
}
/* GHARLIST-UI-1000X-START */

:root {
  --gh-green: #07883f;
  --gh-green-dark: #056b32;
  --gh-green-soft: #eaf7ef;
  --gh-bg: #f6faf8;
  --gh-surface: #ffffff;
  --gh-border: #dce9e1;
  --gh-text: #123d2b;
  --gh-muted: #6d7d75;
  --gh-radius: 18px;
  --gh-shadow: 0 6px 24px rgba(16, 65, 43, 0.07);
  --gh-shadow-hover: 0 12px 30px rgba(16, 65, 43, 0.12);
}

/* ============================================================
   GLOBAL
   ============================================================ */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  background: var(--gh-bg);
  color: var(--gh-text);
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  -webkit-font-smoothing: antialiased;
}

button,
input,
select,
textarea {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  max-width: 100%;
}

/* ============================================================
   HEADER
   ============================================================ */

.top-header {
  position: sticky;
  top: 0;
  z-index: 100;
  width: 100%;
  height: 72px;
  padding: 0 36px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1px solid var(--gh-border);
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.035);
  backdrop-filter: blur(14px);
}

.brand-logo {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  flex: 0 0 auto;
  color: var(--gh-green);
  font-size: 23px;
  line-height: 1;
  font-weight: 850;
  letter-spacing: -0.6px;
}

.brand-mark {
  width: 38px;
  height: 38px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: var(--gh-green);
  color: #fff;
  font-size: 21px;
  font-weight: 900;
  box-shadow: 0 5px 14px rgba(7, 136, 63, 0.20);
}

.desktop-nav {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4px;
  padding: 5px;
  background: #fff;
  border: 1px solid var(--gh-border);
  border-radius: 16px;
}

.desktop-nav a {
  min-height: 40px;
  padding: 0 17px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  color: #53645c;
  font-size: 14px;
  font-weight: 750;
  white-space: nowrap;
  transition:
    background 160ms ease,
    color 160ms ease;
}

.desktop-nav a:hover {
  color: var(--gh-green);
  background: #f1f8f4;
}

.desktop-nav a.active {
  color: var(--gh-green);
  background: #e7f6ed;
}

.mobile-nav {
  display: none;
}

/* ============================================================
   PAGE CONTAINER
   ============================================================ */

.page,
.products-page,
.voice-page,
.my-list-page,
.report-page,
.share-page,
.history-page,
.new-list-page {
  width: 100%;
  max-width: 1440px;
  margin: 0 auto;
  padding: 30px 40px 54px;
}

.page > *,
.products-page > *,
.voice-page > *,
.my-list-page > *,
.report-page > *,
.share-page > *,
.history-page > *,
.new-list-page > * {
  max-width: 100%;
}

/* ============================================================
   HOME
   ============================================================ */

.home-page {
  min-height: calc(100vh - 72px);
  display: flex;
  align-items: center;
}

.hero {
  width: 100%;
  min-height: 520px;
  padding: 56px;
  display: flex;
  align-items: center;
  border: 1px solid var(--gh-border);
  border-radius: 28px;
  background:
    linear-gradient(
      135deg,
      #ffffff 0%,
      #f0f9f4 100%
    );
  box-shadow: var(--gh-shadow);
}

.hero h1 {
  margin: 12px 0 18px;
  color: var(--gh-text);
  font-size: clamp(42px, 5vw, 68px);
  line-height: 0.98;
  letter-spacing: -2.8px;
}

.hero h1 span {
  color: var(--gh-green);
}

.hero p {
  max-width: 650px;
  margin: 0;
  color: var(--gh-muted);
  font-size: 18px;
  line-height: 1.65;
}

.eyebrow {
  color: var(--gh-green);
  font-size: 12px;
  font-weight: 850;
  letter-spacing: 0.11em;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}

.primary-button,
.secondary-button,
.primary-action,
.secondary-action {
  min-height: 46px;
  padding: 0 20px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 800;
  transition:
    transform 160ms ease,
    box-shadow 160ms ease,
    background 160ms ease;
}

.primary-button,
.primary-action {
  border: 1px solid var(--gh-green);
  background: var(--gh-green);
  color: #fff;
  box-shadow: 0 6px 16px rgba(7, 136, 63, 0.18);
}

.primary-button:hover,
.primary-action:hover {
  background: var(--gh-green-dark);
  transform: translateY(-1px);
}

.secondary-button,
.secondary-action {
  border: 1px solid #cfe0d5;
  background: #fff;
  color: var(--gh-green);
}

.secondary-button:hover,
.secondary-action:hover {
  background: var(--gh-green-soft);
}

/* ============================================================
   PRODUCTS PAGE
   ============================================================ */

.products-page {
  padding-top: 26px;
}

.products-page h1,
.products-page > h1 {
  margin: 0;
  color: var(--gh-text);
  font-size: clamp(30px, 3vw, 42px);
  line-height: 1.1;
  letter-spacing: -1.3px;
}

.products-page > p,
.products-page .product-count {
  margin: 7px 0 22px;
  color: var(--gh-muted);
  font-size: 15px;
}

.products-page > button,
.products-page button.clear-filters,
.clear-filters {
  min-height: 38px;
  padding: 0 13px;
  border: 1px solid #cfe0d5;
  border-radius: 10px;
  background: #fff;
  color: #476057;
  font-size: 13px;
  font-weight: 750;
}

.clear-filters:hover {
  background: var(--gh-green-soft);
  color: var(--gh-green);
}

/* ============================================================
   FILTER AREA
   ============================================================ */

.product-filters,
.filters,
.products-toolbar,
.filter-bar {
  width: 100%;
  display: grid;
  grid-template-columns: minmax(280px, 1fr) 240px 240px;
  gap: 12px;
  align-items: center;
  margin: 20px 0 22px;
}

.product-filters input,
.filters input,
.products-toolbar input,
.filter-bar input,
.product-filters select,
.filters select,
.products-toolbar select,
.filter-bar select {
  width: 100%;
  height: 48px;
  min-width: 0;
  padding: 0 15px;
  border: 1px solid var(--gh-border);
  border-radius: 13px;
  outline: none;
  background: #fff;
  color: var(--gh-text);
  font-size: 14px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.025);
}

.product-filters input:focus,
.filters input:focus,
.products-toolbar input:focus,
.filter-bar input:focus,
.product-filters select:focus,
.filters select:focus,
.products-toolbar select:focus,
.filter-bar select:focus {
  border-color: #9bd3b2;
  box-shadow: 0 0 0 3px rgba(7, 136, 63, 0.08);
}

/* ============================================================
   PRODUCT GRID
   ============================================================ */

.product-grid {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
  align-items: stretch;
}

/* ============================================================
   PRODUCT CARD
   ============================================================ */

.product-card {
  min-width: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--gh-border);
  border-radius: 18px;
  background: #fff;
  box-shadow: 0 3px 15px rgba(17, 67, 44, 0.045);
  transition:
    transform 160ms ease,
    box-shadow 160ms ease,
    border-color 160ms ease;
}

.product-card:hover {
  transform: translateY(-3px);
  border-color: #c5dfd0;
  box-shadow: var(--gh-shadow-hover);
}

.product-card-image {
  width: 100%;
  height: 218px;
  min-height: 218px;
  padding: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #f6faf8;
}

.product-card-image img,
.product-card-image .product-image,
.product-card-image picture,
.product-card-image > div {
  width: 100%;
  height: 100%;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.product-card-content {
  min-width: 0;
  flex: 1;
  padding: 14px 15px 15px;
  display: flex;
  flex-direction: column;
}

.product-brand {
  display: block;
  margin-bottom: 6px;
  color: var(--gh-green);
  font-size: 11px;
  line-height: 1.2;
  font-weight: 850;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.product-card h3 {
  min-height: 42px;
  margin: 0;
  color: var(--gh-text);
  font-size: 16px;
  line-height: 1.3;
  font-weight: 780;
  letter-spacing: -0.2px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-unit {
  margin: 7px 0 0;
  color: var(--gh-muted);
  font-size: 13px;
  line-height: 1.3;
}

.product-card-bottom {
  margin-top: auto;
  padding-top: 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.product-price {
  color: var(--gh-text);
  font-size: 18px;
  line-height: 1;
  font-weight: 850;
  white-space: nowrap;
}

.add-button {
  min-width: 78px;
  min-height: 40px;
  padding: 0 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 1px solid var(--gh-green);
  border-radius: 11px;
  background: var(--gh-green);
  color: #fff;
  font-size: 13px;
  font-weight: 850;
  white-space: nowrap;
  transition:
    background 160ms ease,
    transform 160ms ease;
}

.add-button:hover {
  background: var(--gh-green-dark);
  transform: translateY(-1px);
}

.add-button.added {
  min-width: 92px;
  border-color: #b9dfc8;
  background: #e8f7ee;
  color: var(--gh-green);
}

.add-button.added:hover {
  background: #dcf2e5;
}

/* ============================================================
   LOAD MORE
   ============================================================ */

.load-more,
.load-more-button,
.products-page > button:last-child {
  min-height: 44px;
  margin: 26px auto 0;
  padding: 0 22px;
  display: block;
  border: 1px solid var(--gh-green);
  border-radius: 11px;
  background: #fff;
  color: var(--gh-green);
  font-size: 14px;
  font-weight: 800;
  box-shadow: none;
}

.load-more:hover,
.load-more-button:hover,
.products-page > button:last-child:hover {
  background: var(--gh-green);
  color: #fff;
}

/* ============================================================
   CATEGORY CHIP / FILTER CHIP
   ============================================================ */

.category-chip,
.filter-chip {
  min-height: 34px;
  padding: 0 12px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  border: 1px solid #bfe1cd;
  border-radius: 999px;
  background: #f1faf5;
  color: var(--gh-green);
  font-size: 13px;
  font-weight: 700;
}

/* ============================================================
   MY LIST
   ============================================================ */

.shopping-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin: 18px 0;
}

.shopping-list-item {
  width: 100%;
  min-height: 138px;
  display: grid;
  grid-template-columns: 120px minmax(0, 1fr) 180px;
  align-items: center;
  gap: 18px;
  padding: 14px;
  border: 1px solid var(--gh-border);
  border-radius: 17px;
  background: #fff;
  box-shadow: 0 3px 14px rgba(17, 67, 44, 0.05);
}

.shopping-list-image {
  width: 120px;
  height: 108px;
  min-width: 120px;
  max-width: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 13px;
  background: #f7faf8;
}

.shopping-list-image img,
.shopping-list-image picture,
.shopping-list-image > div,
.shopping-list-image > span {
  width: 100%;
  height: 100%;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.shopping-list-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.shopping-list-info h3 {
  margin: 0;
  color: var(--gh-text);
  font-size: 17px;
  line-height: 1.3;
  font-weight: 780;
  overflow-wrap: anywhere;
}

.shopping-list-info .product-unit {
  margin: 0;
  color: var(--gh-muted);
  font-size: 13px;
}

.shopping-list-info .product-price {
  margin: 2px 0 0;
  color: var(--gh-text);
  font-size: 16px;
}

.shopping-list-actions {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: 8px;
}

.quantity-control {
  min-height: 40px;
  padding: 3px;
  display: inline-flex;
  align-items: center;
  border: 1px solid #d4e6dc;
  border-radius: 11px;
  background: #f6faf8;
}

.quantity-control button {
  width: 32px;
  height: 32px;
  min-width: 32px;
  padding: 0;
  border: 0;
  border-radius: 8px;
  background: #fff;
  color: var(--gh-green);
  font-size: 19px;
  font-weight: 800;
}

.quantity-control button:hover {
  background: var(--gh-green-soft);
}

.quantity-control span {
  min-width: 34px;
  text-align: center;
  color: var(--gh-text);
  font-size: 15px;
  font-weight: 850;
}

.line-total {
  min-width: 90px;
  color: var(--gh-green);
  font-size: 18px;
  font-weight: 850;
  text-align: right;
  white-space: nowrap;
}

.remove-button {
  padding: 3px 0;
  border: 0;
  background: transparent;
  color: #9a6868;
  font-size: 12px;
  font-weight: 650;
}

.remove-button:hover {
  color: #c0392b;
}

.list-summary {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin-top: 14px;
}

.list-summary > * {
  min-width: 0;
}

.list-footer-actions {
  width: 100%;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 10px;
  margin-top: 14px;
  padding-bottom: 12px;
}

/* ============================================================
   VOICE
   ============================================================ */

.voice-page {
  padding-top: 34px;
}

.voice-card,
.voice-panel,
.voice-container {
  width: 100%;
  max-width: 820px;
  margin: 0 auto;
  padding: 34px;
  border: 1px solid var(--gh-border);
  border-radius: 22px;
  background: #fff;
  box-shadow: var(--gh-shadow);
}

.voice-page h1,
.voice-page h2 {
  color: var(--gh-text);
  letter-spacing: -0.8px;
}

.large-mic {
  width: 76px;
  height: 76px;
  margin: 18px auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 50%;
  background: var(--gh-green);
  color: #fff;
  box-shadow: 0 10px 26px rgba(7, 136, 63, 0.22);
}

.large-mic:hover {
  background: var(--gh-green-dark);
}

.large-mic.listening {
  box-shadow:
    0 0 0 9px rgba(7, 136, 63, 0.10),
    0 10px 28px rgba(7, 136, 63, 0.25);
}

.voice-example,
.voice-result {
  margin-top: 14px;
  padding: 13px 15px;
  border: 1px solid var(--gh-border);
  border-radius: 12px;
  background: #f7faf8;
  color: var(--gh-muted);
  font-size: 14px;
  line-height: 1.5;
}

.voice-result {
  color: var(--gh-text);
  font-weight: 700;
}

.voice-product-grid,
.voice-results,
.voice-matches {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  margin-top: 20px;
}

/* ============================================================
   REPORT
   ============================================================ */

.report-page {
  padding-top: 34px;
}

.report-page h1 {
  margin: 0;
  color: var(--gh-text);
  font-size: clamp(34px, 4vw, 52px);
  line-height: 1;
  letter-spacing: -2px;
}

.report-page h2 {
  color: var(--gh-text);
}

.report-page button,
.share-page button,
.history-page button,
.new-list-page button {
  border-radius: 11px;
}

.report-page img {
  object-fit: contain;
}

.report-page .report-image,
.report-page .shopping-report-image,
.report-page .item-image {
  width: 112px;
  height: 104px;
  object-fit: contain;
  border-radius: 12px;
  background: #f7faf8;
}

.report-page .report-item,
.report-page .report-row,
.report-page .shopping-report-item {
  min-height: 128px;
  padding: 14px;
  margin-bottom: 12px;
  display: grid;
  grid-template-columns: 112px minmax(0, 1fr) auto;
  align-items: center;
  gap: 16px;
  border: 1px solid var(--gh-border);
  border-radius: 17px;
  background: #fff;
  box-shadow: 0 3px 14px rgba(17, 67, 44, 0.045);
}

.report-page .report-summary,
.report-page .summary-grid,
.report-page .report-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin: 18px 0;
}

.report-page .report-summary > *,
.report-page .summary-grid > *,
.report-page .report-stats > * {
  min-width: 0;
}

.report-page .report-item-total,
.report-page .item-total,
.report-page .total {
  color: var(--gh-green);
  font-size: 20px;
  font-weight: 850;
  white-space: nowrap;
}

.report-page .report-actions,
.report-page .action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 18px;
}

.report-page .report-actions button,
.report-page .action-row button {
  min-height: 44px;
  padding: 0 17px;
  border: 1px solid var(--gh-green);
  background: var(--gh-green);
  color: #fff;
  font-weight: 800;
}

/* ============================================================
   SHARE / HISTORY / NEW LIST
   ============================================================ */

.share-page,
.history-page,
.new-list-page {
  max-width: 1100px;
}

.share-page > *,
.history-page > *,
.new-list-page > * {
  max-width: 100%;
}

.share-page button,
.history-page button,
.new-list-page button {
  min-height: 44px;
  padding: 0 17px;
  border: 1px solid #cfe0d5;
  background: #fff;
  color: var(--gh-green);
  font-weight: 800;
}

.share-page button:hover,
.history-page button:hover,
.new-list-page button:hover {
  background: var(--gh-green-soft);
}

.share-page .primary-button,
.history-page .primary-button,
.new-list-page .primary-button {
  border-color: var(--gh-green);
  background: var(--gh-green);
  color: #fff;
}

.history-page article,
.history-page .history-item,
.history-page .history-card {
  margin-bottom: 12px;
  padding: 18px;
  border: 1px solid var(--gh-border);
  border-radius: 16px;
  background: #fff;
  box-shadow: 0 3px 13px rgba(17, 67, 44, 0.045);
}

/* ============================================================
   ALL BUTTON NORMALIZATION
   Prevent browser-default ugly buttons.
   ============================================================ */

.products-page button,
.voice-page button,
.my-list-page button,
.report-page button,
.share-page button,
.history-page button,
.new-list-page button {
  font-weight: 750;
}

.products-page button:focus-visible,
.voice-page button:focus-visible,
.my-list-page button:focus-visible,
.report-page button:focus-visible,
.share-page button:focus-visible,
.history-page button:focus-visible,
.new-list-page button:focus-visible,
.desktop-nav a:focus-visible,
.brand-logo:focus-visible {
  outline: 3px solid rgba(7, 136, 63, 0.20);
  outline-offset: 2px;
}

/* ============================================================
   IMAGE FALLBACK
   ============================================================ */

.product-image-fallback,
.image-fallback {
  width: 100%;
  height: 100%;
  min-height: 100px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9aa9a1;
  background: #f1f5f3;
}

/* ============================================================
   RESPONSIVE — LAPTOP
   ============================================================ */

@media (max-width: 1180px) {
  .top-header {
    padding: 0 24px;
  }

  .page,
  .products-page,
  .voice-page,
  .my-list-page,
  .report-page,
  .share-page,
  .history-page,
  .new-list-page {
    padding-left: 24px;
    padding-right: 24px;
  }

  .product-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .product-card-image {
    height: 205px;
    min-height: 205px;
  }

  .shopping-list-item {
    grid-template-columns: 105px minmax(0, 1fr) 165px;
  }

  .shopping-list-image {
    width: 105px;
    height: 96px;
    min-width: 105px;
  }
}

/* ============================================================
   RESPONSIVE — TABLET
   ============================================================ */

@media (max-width: 900px) {
  .top-header {
    height: 66px;
    padding: 0 18px;
  }

  .brand-logo {
    font-size: 20px;
  }

  .brand-mark {
    width: 35px;
    height: 35px;
  }

  .desktop-nav {
    gap: 2px;
  }

  .desktop-nav a {
    min-height: 36px;
    padding: 0 11px;
    font-size: 13px;
  }

  .page,
  .products-page,
  .voice-page,
  .my-list-page,
  .report-page,
  .share-page,
  .history-page,
  .new-list-page {
    padding: 24px 18px 42px;
  }

  .product-filters,
  .filters,
  .products-toolbar,
  .filter-bar {
    grid-template-columns: minmax(0, 1fr) 180px;
  }

  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .product-card-image {
    height: 210px;
    min-height: 210px;
  }

  .shopping-list-item {
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 14px;
  }

  .shopping-list-image {
    width: 96px;
    height: 90px;
    min-width: 96px;
  }

  .shopping-list-actions {
    grid-column: 2;
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .line-total {
    text-align: left;
  }

  .voice-product-grid,
  .voice-results,
  .voice-matches {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .report-page .report-item,
  .report-page .report-row,
  .report-page .shopping-report-item {
    grid-template-columns: 92px minmax(0, 1fr);
  }

  .report-page .report-item-total,
  .report-page .item-total,
  .report-page .total {
    grid-column: 2;
    text-align: left;
  }
}

/* ============================================================
   RESPONSIVE — MOBILE
   ============================================================ */

@media (max-width: 680px) {
  body {
    padding-bottom: 68px;
  }

  .top-header {
    height: 60px;
    padding: 0 14px;
  }

  .brand-logo {
    font-size: 18px;
    gap: 8px;
  }

  .brand-mark {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    font-size: 18px;
  }

  .desktop-nav {
    display: none;
  }

  .mobile-nav {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 200;
    height: 64px;
    padding: 5px 8px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2px;
    border-top: 1px solid var(--gh-border);
    background: rgba(255, 255, 255, 0.97);
    box-shadow: 0 -4px 18px rgba(0, 0, 0, 0.06);
    backdrop-filter: blur(14px);
  }

  .mobile-nav a {
    min-width: 0;
    padding: 5px 2px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    border-radius: 10px;
    color: #74817b;
    font-size: 10px;
    font-weight: 750;
  }

  .mobile-nav a.active {
    color: var(--gh-green);
    background: var(--gh-green-soft);
  }

  .page,
  .products-page,
  .voice-page,
  .my-list-page,
  .report-page,
  .share-page,
  .history-page,
  .new-list-page {
    padding: 18px 12px 30px;
  }

  .products-page h1,
  .products-page > h1 {
    font-size: 29px;
  }

  .product-filters,
  .filters,
  .products-toolbar,
  .filter-bar {
    grid-template-columns: 1fr;
    gap: 9px;
    margin: 15px 0 18px;
  }

  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .product-card {
    border-radius: 14px;
  }

  .product-card-image {
    height: 155px;
    min-height: 155px;
    padding: 9px;
  }

  .product-card-content {
    padding: 10px;
  }

  .product-brand {
    margin-bottom: 4px;
    font-size: 9px;
  }

  .product-card h3 {
    min-height: 37px;
    font-size: 13px;
  }

  .product-unit {
    margin-top: 5px;
    font-size: 11px;
  }

  .product-card-bottom {
    padding-top: 9px;
    gap: 5px;
  }

  .product-price {
    font-size: 15px;
  }

  .add-button {
    min-width: 58px;
    min-height: 36px;
    padding: 0 9px;
    border-radius: 9px;
    font-size: 11px;
  }

  .add-button.added {
    min-width: 67px;
  }

  .shopping-list {
    gap: 10px;
  }

  .shopping-list-item {
    grid-template-columns: 76px minmax(0, 1fr);
    gap: 10px;
    padding: 10px;
    border-radius: 14px;
  }

  .shopping-list-image {
    width: 76px;
    height: 76px;
    min-width: 76px;
    border-radius: 10px;
  }

  .shopping-list-info h3 {
    font-size: 14px;
  }

  .shopping-list-info .product-unit {
    font-size: 11px;
  }

  .shopping-list-info .product-price {
    font-size: 14px;
  }

  .shopping-list-actions {
    grid-column: 1 / -1;
    flex-wrap: wrap;
    gap: 7px;
  }

  .quantity-control {
    min-height: 36px;
  }

  .quantity-control button {
    width: 29px;
    height: 29px;
    min-width: 29px;
  }

  .quantity-control span {
    min-width: 27px;
    font-size: 14px;
  }

  .line-total {
    font-size: 15px;
  }

  .list-summary {
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .list-footer-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .list-footer-actions button,
  .list-footer-actions a {
    width: 100%;
  }

  .voice-card,
  .voice-panel,
  .voice-container {
    padding: 22px 15px;
    border-radius: 17px;
  }

  .voice-product-grid,
  .voice-results,
  .voice-matches {
    grid-template-columns: 1fr;
  }

  .large-mic {
    width: 68px;
    height: 68px;
  }

  .report-page h1 {
    font-size: 34px;
  }

  .report-page .report-summary,
  .report-page .summary-grid,
  .report-page .report-stats {
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .report-page .report-item,
  .report-page .report-row,
  .report-page .shopping-report-item {
    grid-template-columns: 76px minmax(0, 1fr);
    gap: 10px;
    min-height: 100px;
    padding: 10px;
    border-radius: 14px;
  }

  .report-page .report-image,
  .report-page .shopping-report-image,
  .report-page .item-image {
    width: 76px;
    height: 76px;
  }

  .report-page .report-item-total,
  .report-page .item-total,
  .report-page .total {
    grid-column: 2;
    font-size: 16px;
  }

  .report-page .report-actions,
  .report-page .action-row {
    flex-direction: column;
  }

  .report-page .report-actions button,
  .report-page .action-row button {
    width: 100%;
  }

  .hero {
    min-height: 0;
    padding: 30px 22px;
    border-radius: 20px;
  }

  .hero h1 {
    font-size: 42px;
    letter-spacing: -1.8px;
  }

  .hero p {
    font-size: 15px;
  }

  .hero-actions {
    flex-direction: column;
  }

  .primary-button,
  .secondary-button,
  .primary-action,
  .secondary-action {
    width: 100%;
  }
}

/* ============================================================
   SMALL MOBILE
   ============================================================ */

@media (max-width: 420px) {
  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .product-card-image {
    height: 135px;
    min-height: 135px;
  }

  .product-card-content {
    padding: 9px;
  }

  .product-card h3 {
    font-size: 12px;
  }

  .product-price {
    font-size: 14px;
  }

  .add-button {
    min-width: 53px;
    min-height: 34px;
    padding: 0 7px;
    font-size: 10px;
  }
}

/* ============================================================
   PRINT
   ============================================================ */

@media print {
  .top-header,
  .desktop-nav,
  .mobile-nav,
  .report-actions,
  .action-row,
  button {
    display: none !important;
  }

  body {
    background: #fff;
  }

  .report-page {
    max-width: none;
    padding: 0;
  }

  .report-page .report-item,
  .report-page .report-row,
  .report-page .shopping-report-item {
    break-inside: avoid;
    box-shadow: none;
  }
}

/* GHARLIST-UI-1000X-END */

